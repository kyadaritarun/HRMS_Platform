datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PRODUCT_SUPER_ADMIN
  COMPANY_ADMIN
  HR
  FINANCE
  IT
  EMPLOYEE
}

enum WorkMode {
  WFO
  WFH
  HYBRID
}

enum RequestType {
  LEAVE
  COMP_OFF
  REGULARIZATION
  CLAIM
  GOAL
  TASK
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  PAID
}

// ------------------------------------------------------------------
// Company: tenant root. Absorbs Subscription, CompanyShift,
// CompanyInfrastructure, ClaimCategory, ClaimCurrency, QuickLink,
// PerformanceCycle.
// ------------------------------------------------------------------
model Company {
  id                  Int       @id @default(autoincrement())
  name                String
  code                String    @unique
  subdomain           String    @unique
  customDomain        String?   @unique
  serverId            Int?
  server              Server?   @relation(fields: [serverId], references: [id])
  logo                String?
  website             String?
  address             Json      @default("{}")  // AddressJson
  workingDays         String    @default("mon,tue,wed,thu,fri")
  timezone            String    @default("Asia/Kolkata")
  shifts              Json      @default("[]")  // ShiftJson[]
  settings            Json      @default("{}")  // CompanySettingsJson
  allowedEmailDomains String    @default("")
  isActive            Boolean   @default(true)

  // subscription (1:1, merged in)
  packageId           Int?
  package             Package?  @relation(fields: [packageId], references: [id])
  planType            String    @default("MONTHLY") // MONTHLY | QUARTERLY | YEARLY
  subAmount           Decimal?  @db.Decimal(10, 2)
  subStartDate        DateTime  @default(now())
  subEndDate          DateTime?
  nextPaymentDate     DateTime?
  subIsActive         Boolean   @default(true)
  lastExpiryAlertSentAt DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  users               User[]
  departments         Department[]
  holidays            Holiday[]
  leaveTypes          LeaveType[]
  attendance          Attendance[]
  requests            Request[]
  payslips            Payslip[]
  documents           Document[]
  tickets             Ticket[]
  notifications       Notification[]
  policies            Policy[]
  activityLogs        ActivityLog[]
  invoices            Invoice[]
  emailLogs           EmailLog[]
  paymentOrders       SubscriptionPaymentOrder[]
  offerLetters        OfferLetter[]
  exitRecords         ExitRecord[]
  companyAssets       CompanyAsset[]
  onboardingProgress  OnboardingProgress[]
  hrLetters           HrLetter[]
  rosterAssignments   RosterAssignment[]
  loanAdvances        LoanAdvance[]
  taxDeclarations     TaxDeclaration[]
  complianceReports   ComplianceReport[]
}

model Package {
  id              Int       @id @default(autoincrement())
  name            String
  description     String    @default("")
  currency        String    @default("INR")
  priceMonthly    Decimal?  @db.Decimal(10, 2)
  priceQuarterly  Decimal?  @db.Decimal(10, 2)
  priceYearly     Decimal?  @db.Decimal(10, 2)
  employeeLimit   Int       @default(10)
  billingDefault  String    @default("MONTHLY")
  enabledFeatures Json      @default("[]") // string[]
  createdAt       DateTime  @default(now())
  companies       Company[]
  paymentOrders   SubscriptionPaymentOrder[]
}

// ------------------------------------------------------------------
// User: absorbs EmployeeProfile, EmployeeSalary, CompanyRole.
// ------------------------------------------------------------------
model User {
  id                    Int         @id @default(autoincrement())
  email                 String      @unique
  username              String      @unique
  passwordHash          String
  firstName             String      @default("")
  lastName              String      @default("")
  phone                 String      @default("")
  role                  Role        @default(EMPLOYEE)
  isActive              Boolean     @default(true)
  profilePhoto          String?
  mustChangePassword    Boolean     @default(false)
  tempPasswordExpiresAt DateTime?
  addedBySuperadmin     Boolean     @default(false)
  hrPermissions         Json?       // string[] | null (null = full HR access)
  canManagePerformance  Boolean     @default(false)

  companyId             Int?
  company               Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId          Int?
  department            Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managerId             Int?
  manager               User?       @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  reports               User[]      @relation("Reports")
  jobTitle              String      @default("")
  shiftId               String?     // id of an entry in Company.shifts
  workMode              WorkMode    @default(WFO)
  employmentType        String      @default("FULL_TIME") // FULL_TIME | PART_TIME

  // profile (was EmployeeProfile)
  employeeNumber        String      @default("")
  joiningDate           DateTime?
  dateOfBirth           DateTime?
  probationStart        DateTime?
  probationEnd          DateTime?
  noticePeriodDays      Int?
  personalEmail         String      @default("")
  address               String      @default("")
  workingAddress        String      @default("")
  shiftTiming           String      @default("")
  emergencyContact      Json        @default("{}") // {name, relationship, phone}

  // salary (was EmployeeSalary)
  monthlySalary         Decimal     @default(0) @db.Decimal(12, 2)
  currency              String      @default("INR")
  salaryEffectiveDate   DateTime?
  bankDetails           Json        @default("{}") // BankDetailsJson

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  attendance            Attendance[]
  leaveBalances         LeaveBalance[]
  requests              Request[]      @relation("Requester")
  approvals             Request[]      @relation("Approver")
  documents             Document[]
  ticketsRequested      Ticket[]       @relation("TicketRequester")
  ticketsAssigned       Ticket[]       @relation("TicketAssignee")
  notifications         Notification[]
  payslips              Payslip[]

  @@index([companyId, role])
  @@index([companyId, managerId])
}

model Department {
  id        Int          @id @default(autoincrement())
  companyId Int
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean      @default(true)
  parentId  Int?
  parent    Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children  Department[] @relation("DeptTree")
  users     User[]
  tickets   Ticket[]

  @@unique([companyId, name])
}

model Holiday {
  id          Int      @id @default(autoincrement())
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  date        DateTime @db.Date
  type        String   @default("PUBLIC") // PUBLIC | FLOATER | OPTIONAL
  description String   @default("")

  @@index([companyId, date])
}

model Attendance {
  id            Int       @id @default(autoincrement())
  companyId     Int
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId       String?
  checkIn       DateTime
  checkOut      DateTime?
  workMode      WorkMode  @default(WFO)
  note          String    @default("")
  checkInGeo    Json?     // {lat, lng, address}
  checkOutGeo   Json?
  durationHours Decimal   @default(0) @db.Decimal(5, 2)
  createdAt     DateTime  @default(now())

  @@index([userId, checkIn])
  @@index([companyId, checkIn])
}

model LeaveType {
  id                Int            @id @default(autoincrement())
  companyId         Int
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  code              String
  defaultAllocation Decimal        @default(0) @db.Decimal(6, 2)
  isPaid            Boolean        @default(true)
  requiresApproval  Boolean        @default(true)
  allowHalfDay      Boolean        @default(false)
  allowCarry        Boolean        @default(false)
  isCompOff         Boolean        @default(false)
  isActive          Boolean        @default(true)
  accrual           Json           @default("{}") // {frequency: 'NONE'|'MONTHLY'|'YEARLY', amount: number}
  color             String         @default("blue")
  balances          LeaveBalance[]
  requests          Request[]

  @@unique([companyId, code])
}

model LeaveBalance {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId Int
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  balance     Decimal   @default(0) @db.Decimal(6, 2)
  carriedOver Decimal   @default(0) @db.Decimal(6, 2)
  updatedAt   DateTime  @updatedAt

  @@unique([userId, leaveTypeId])
}

// ------------------------------------------------------------------
// Request: ONE approval workflow for LEAVE, COMP_OFF, REGULARIZATION,
// CLAIM, GOAL, TASK. See section 8.4 for per-type field usage.
// ------------------------------------------------------------------
model Request {
  id           Int           @id @default(autoincrement())
  type         RequestType
  companyId    Int
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       Int
  user         User          @relation("Requester", fields: [userId], references: [id], onDelete: Cascade)
  approverId   Int?
  approver     User?         @relation("Approver", fields: [approverId], references: [id])
  status       RequestStatus @default(PENDING)
  title        String        @default("")
  reason       String        @default("")
  decisionNote String        @default("")
  startDate    DateTime?     @db.Date
  endDate      DateTime?     @db.Date
  days         Decimal?      @db.Decimal(4, 2)
  amount       Decimal?      @db.Decimal(10, 2)
  leaveTypeId  Int?
  leaveType    LeaveType?    @relation(fields: [leaveTypeId], references: [id])
  meta         Json          @default("{}") // per-type, see section 5
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  resolvedAt   DateTime?

  @@index([companyId, type, status])
  @@index([userId, type])
  @@index([approverId, status])
}

// ------------------------------------------------------------------
// Payslip: absorbs PayrollAdjustment (DRAFT) and PublishedPayslip.
// ------------------------------------------------------------------
model Payslip {
  id              Int       @id @default(autoincrement())
  companyId       Int
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      Int
  employee        User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month           Int
  year            Int
  status          String    @default("DRAFT") // DRAFT | PUBLISHED
  bonus           Decimal   @default(0) @db.Decimal(10, 2)
  otherDeductions Decimal   @default(0) @db.Decimal(10, 2)
  remarks         String    @default("")
  snapshot        Json?     // PayslipSnapshotJson, written on publish
  netSalary       Decimal?  @db.Decimal(12, 2)
  publishedById   Int?
  publishedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId, month, year])
  @@index([companyId, year, month])
}

// ------------------------------------------------------------------
// Document: absorbs EmployeeEducation, EmployeeExperience and all
// *Version tables.
// ------------------------------------------------------------------
model Document {
  id            Int       @id @default(autoincrement())
  companyId     Int
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadedById  Int?
  category      String    // IDENTITY | EDUCATION | EXPERIENCE | ONBOARDING | OTHER
  title         String
  identifier    String    @default("")
  issueDate     DateTime? @db.Date
  expiryDate    DateTime? @db.Date
  fileUrl       String?
  notes         String    @default("")
  data          Json      @default("{}") // EDUCATION / EXPERIENCE fields, see section 5
  versions      Json      @default("[]") // DocumentVersionJson[]
  status        String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  rejectionNote String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, category])
  @@index([companyId, status])
}

// ------------------------------------------------------------------
// Ticket: absorbs SupportTicketComment.
// ------------------------------------------------------------------
model Ticket {
  id           Int         @id @default(autoincrement())
  companyId    Int
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requesterId  Int
  requester    User        @relation("TicketRequester", fields: [requesterId], references: [id])
  assigneeId   Int?
  assignee     User?       @relation("TicketAssignee", fields: [assigneeId], references: [id])
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  code         String      @unique
  category     String
  subject      String
  description  String
  priority     String      @default("MEDIUM") // LOW | MEDIUM | HIGH
  status       String      @default("OPEN")   // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  comments     Json        @default("[]")     // TicketCommentJson[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([companyId, status])
  @@index([assigneeId, status])
}

// ------------------------------------------------------------------
// Notification: absorbs Appreciation (kind = KUDOS).
// ------------------------------------------------------------------
model Notification {
  id         Int       @id @default(autoincrement())
  companyId  Int
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String    // LEAVE | CLAIM | TICKET | BIRTHDAY | HOLIDAY | KUDOS | SYSTEM ...
  title      String
  message    String    @default("")
  url        String    @default("")
  payload    Json      @default("{}")
  eventDate  DateTime? @db.Date
  sourceType String    @default("")
  sourceId   String    @default("")
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, isRead])
  @@index([companyId, kind, createdAt])
}

// ------------------------------------------------------------------
// Policy: absorbs PolicyAcceptance.
// ------------------------------------------------------------------
model Policy {
  id            Int       @id @default(autoincrement())
  companyId     Int
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  policyType    String    // HR | LEAVE | CLAIM | OTHER
  title         String
  slug          String
  body          String    @default("")
  documentUrl   String?
  extractedText String    @default("")
  validUntil    DateTime? @db.Date
  version       Int       @default(1)
  isActive      Boolean   @default(true)
  acceptances   Json      @default("[]") // [{userId, version, at}]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([companyId, slug])
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId    Int?
  action     String
  objectType String   @default("")
  objectId   String   @default("")
  message    String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
}

// ------------------------------------------------------------------
// Invoice: absorbs PaymentIntent into `payment` JSON.
// ------------------------------------------------------------------
model Invoice {
  id            Int       @id @default(autoincrement())
  companyId     Int
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceNumber String    @unique
  amount        Decimal   @db.Decimal(10, 2)
  currency      String    @default("INR")
  billingCycle  String    @default("MONTHLY")
  periodStart   DateTime
  periodEnd     DateTime
  dueDate       DateTime
  status        String    @default("PENDING") // DRAFT | PENDING | PAID | OVERDUE
  payment       Json      @default("{}")      // {provider, reference, status, billingEmail}
  issuedAt      DateTime  @default(now())
  paidAt        DateTime?

  @@index([companyId, status])
}

// ------------------------------------------------------------------
// OPTIONAL (Super Admin infrastructure module): absorbs DomainDeployment.
// ------------------------------------------------------------------
model Server {
  id          Int       @id @default(autoincrement())
  name        String
  host        String
  sshPort     Int       @default(22)
  username    String
  authType    String    @default("password") // password | private_key
  credentials String    @default("")         // AES-256-GCM encrypted
  publicIp    String    @default("")
  proxyHost   String    @default("")
  proxyPort   Int?
  appRoot     String    @default("")
  staticRoot  String    @default("")
  mediaRoot   String    @default("")
  status      String    @default("active")
  deployments Json      @default("[]") // DeploymentJson[]
  createdAt   DateTime  @default(now())
  companies   Company[]
}

// ------------------------------------------------------------------
// OPTIONAL (Super Admin email notifications page).
// ------------------------------------------------------------------
model EmailLog {
  id           Int      @id @default(autoincrement())
  companyId    Int?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  invoiceId    Int?
  subject      String
  toEmail      String
  cc           String   @default("")
  bcc          String   @default("")
  bodyHtml     String   @default("")
  category     String   @default("")
  templateKey  String   @default("")
  status       String   @default("QUEUED") // QUEUED | SENT | FAILED
  errorMessage String   @default("")
  sentAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
}

// ------------------------------------------------------------------
// SubscriptionPaymentOrder: Tracks Razorpay payment links, proposals,
// onboarding payments, and plan upgrades.
// ------------------------------------------------------------------
model SubscriptionPaymentOrder {
  id              Int       @id @default(autoincrement())
  orderId         String    @unique // rzp_plink_xxx or rzp_order_xxx
  paymentId       String?   // rzp_pay_xxx
  companyName     String
  contactName     String    @default("")
  contactEmail    String
  contactPhone    String    @default("")
  subdomain       String
  packageId       Int
  package         Package   @relation(fields: [packageId], references: [id])
  planType        String    @default("MONTHLY") // MONTHLY | QUARTERLY | YEARLY
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("INR")
  status          String    @default("PENDING") // PENDING | PAID | EXPIRED | FAILED
  paymentLinkUrl  String    @default("")
  companyId       Int?
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  invoiceId       Int?
  isUpgrade       Boolean   @default(false)
  meta            Json      @default("{}") // e.g. custom limits, features, remarks
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
  expiresAt       DateTime?

  @@index([contactEmail, status])
  @@index([orderId])
  @@index([companyId])
}

// ------------------------------------------------------------------
// OfferLetter: Full lifecycle candidate offer letters & salary breakdown
// ------------------------------------------------------------------
model OfferLetter {
  id                        Int       @id @default(autoincrement())
  letterCode                String    @default("") // OL-2026-101
  companyId                 Int
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidateName             String
  candidateEmail            String
  candidatePhone            String    @default("")
  jobTitle                  String
  department                String    @default("")
  annualCtc                 Decimal   @default(0) @db.Decimal(12, 2)
  monthlySalary             Decimal   @default(0) @db.Decimal(12, 2)
  joiningDate               DateTime? @db.Date
  status                    String    @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED | JOINED
  terms                     Json      @default("{}") // {probationMonths, noticeDays, workMode, workingHours}
  breakdown                 Json      @default("{}") // {basicMonthly, hraMonthly, specialAllowanceMonthly, pfMonthly, ptMonthly, netMonthly}
  customComponents          Json      @default("[]") // [{name, monthly, annual, type}]
  attachedFiles             Json      @default("[]") // [{name, size, url}]
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([companyId, status])
  @@index([companyId, candidateEmail])
}

// ------------------------------------------------------------------
// ExitRecord: Employee resignation, notice period, NOC and F&F settlement
// ------------------------------------------------------------------
model ExitRecord {
  id                        Int       @id @default(autoincrement())
  exitCode                  String    @default("") // EXIT-2026-001
  companyId                 Int
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId                Int
  employeeName              String
  employeeEmail             String
  department                String    @default("")
  jobTitle                  String    @default("")
  joiningDate               DateTime? @db.Date
  resignationDate           DateTime? @db.Date
  noticePeriodDays          Int       @default(30)
  lastWorkingDay            DateTime? @db.Date
  reason                    String    @default("")
  status                    String    @default("RESIGNED") // RESIGNED | NOTICE_PERIOD | NOC_CLEARANCE | SETTLED | CANCELLED
  monthlySalary             Decimal   @default(0) @db.Decimal(12, 2)
  leaveBalanceDays          Decimal   @default(0) @db.Decimal(5, 2)
  nocClearance              Json      @default("{}") // {it: {cleared, remarks, clearedBy}, admin, finance, hr}
  ffSettlement              Json      @default("{}") // {daysWorkedInMonth, monthEarnings, leaveEncashmentAmount, gratuityAmount, noticeShortfallDeduction, otherDeductions, netPayout}
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([companyId, status])
  @@index([companyId, employeeId])
}

// ------------------------------------------------------------------
// CompanyAsset: Hardware & IT equipment asset registry
// ------------------------------------------------------------------
model CompanyAsset {
  id                        Int       @id @default(autoincrement())
  companyId                 Int
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag                       String    // e.g. AST-LPT-101
  name                      String
  category                  String    @default("LAPTOP") // LAPTOP | MONITOR | MOBILE | ACCESSORY | DESKTOP | OTHER
  serialNumber              String    @default("")
  assignedToEmployeeId      Int?
  assignedToName            String?
  assignedDate              DateTime? @db.Date
  condition                 String    @default("NEW") // NEW | EXCELLENT | GOOD | FAIR | DAMAGED
  status                    String    @default("IN_STOCK") // IN_STOCK | ASSIGNED | UNDER_MAINTENANCE | RETIRED
  notes                     String    @default("")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([companyId, tag])
  @@index([companyId, status])
  @@index([companyId, assignedToEmployeeId])
}

// ------------------------------------------------------------------
// OnboardingProgress: Per-employee onboarding checklist progress
// ------------------------------------------------------------------
model OnboardingProgress {
  id                        Int       @id @default(autoincrement())
  companyId                 Int
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId                Int
  taskId                    String    // e.g. t1, t2, t3
  completed                 Boolean   @default(false)
  completedAt               DateTime?
  completedBy               String?
  notes                     String    @default("")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([companyId, employeeId, taskId])
  @@index([companyId, employeeId])
}

// ------------------------------------------------------------------
// HrLetter: Official company letters (Relieving, Bonafide, Warning, etc.)
// ------------------------------------------------------------------
model HrLetter {
  id                        Int       @id @default(autoincrement())
  letterCode                String    @default("") // LTR-2026-001
  companyId                 Int
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type                      String    // RELIEVING_EXPERIENCE | BONAFIDE_EMPLOYMENT | APPOINTMENT | PROMOTION | INTERNSHIP | WARNING | SALARY_REVISION
  employeeName              String
  employeeId                String    @default("")
  designation               String    @default("")
  department                String    @default("")
  issueDate                 DateTime? @db.Date
  referenceNumber           String    @default("")
  contentSnapshot           Json      @default("{}") // {title, salutation, paragraphs, customFields}
  signatoryName             String    @default("")
  signatoryDesignation      String    @default("")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([companyId, type])
  @@index([companyId, employeeName])
}

// ------------------------------------------------------------------
// RosterAssignment: Weekly shift roster assignments
// ------------------------------------------------------------------
model RosterAssignment {
  id                        Int       @id @default(autoincrement())
  companyId                 Int
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId                Int
  date                      String    // YYYY-MM-DD
  shiftTiming               String    // e.g. "Morning Shift (07:00 AM - 03:00 PM)" or "Weekly Off"
  shiftId                   String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([companyId, employeeId, date])
  @@index([companyId, date])
}

// ------------------------------------------------------------------
// LoanAdvance: Employee salary advances and personal emergency loans
// ------------------------------------------------------------------
model LoanAdvance {
  id                        Int       @id @default(autoincrement())
  loanCode                  String    @default("") // LN-2026-101
  companyId                 Int
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId                Int
  employeeName              String
  employeeEmail             String
  department                String    @default("")
  type                      String    @default("EMERGENCY_ADVANCE") // EMERGENCY_ADVANCE | SALARY_ADVANCE | FESTIVAL_ADVANCE | PERSONAL_LOAN
  principalAmount           Decimal   @db.Decimal(12, 2)
  tenureMonths              Int       @default(1)
  monthlyEmi                Decimal   @db.Decimal(12, 2)
  totalRepaid               Decimal   @default(0) @db.Decimal(12, 2)
  balanceRemaining          Decimal   @db.Decimal(12, 2)
  reason                    String    @default("")
  status                    String    @default("PENDING") // PENDING | APPROVED | DISBURSED | REJECTED | CLOSED
  appliedDate               DateTime  @default(now())
  approvedDate              DateTime?
  disbursedDate             DateTime?
  utrNumber                 String?
  rejectionReason           String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([companyId, status])
  @@index([companyId, employeeId])
}

// ------------------------------------------------------------------
// TaxDeclaration: IT regime declaration, 80C, 80D, HRA, home loan proofs
// ------------------------------------------------------------------
model TaxDeclaration {
  id                        Int       @id @default(autoincrement())
  companyId                 Int
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId                Int
  financialYear             String    @default("2026-2027")
  regime                    String    @default("NEW_REGIME") // NEW_REGIME | OLD_REGIME
  grossSalary               Decimal   @default(0) @db.Decimal(12, 2)
  section80CDeclared        Decimal   @default(0) @db.Decimal(12, 2)
  section80CVerified        Decimal   @default(0) @db.Decimal(12, 2)
  section80DDeclared        Decimal   @default(0) @db.Decimal(12, 2)
  section80DVerified        Decimal   @default(0) @db.Decimal(12, 2)
  hraDeclared               Decimal   @default(0) @db.Decimal(12, 2)
  hraVerified               Decimal   @default(0) @db.Decimal(12, 2)
  homeLoanInterestDeclared  Decimal   @default(0) @db.Decimal(12, 2)
  homeLoanInterestVerified  Decimal   @default(0) @db.Decimal(12, 2)
  status                    String    @default("PENDING_REVIEW") // PENDING_REVIEW | VERIFIED | LOCKED
  proofFiles                Json      @default("[]") // [{name, size, category, status, url}]
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([companyId, employeeId, financialYear])
  @@index([companyId, financialYear, status])
}

// ------------------------------------------------------------------
// ComplianceReport: Monthly PF, ESI, PT, and TDS filing records
// ------------------------------------------------------------------
model ComplianceReport {
  id                        Int       @id @default(autoincrement())
  companyId                 Int
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type                      String    // PF | ESI | PT | TDS
  month                     Int
  year                      Int
  status                    String    @default("DRAFT") // DRAFT | FILED | AUDITED
  challanNumber             String?
  paymentDate               DateTime? @db.Date
  totalAmount               Decimal   @default(0) @db.Decimal(12, 2)
  recordsCount              Int       @default(0)
  details                   Json      @default("{}")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([companyId, type, month, year])
  @@index([companyId, year, month])
}
